# Provider Configuration
# Copy to .env and fill in your values

# Path to 9Router database (SQLite)
# Windows: C:\Users\{user}\AppData\Roaming\9router\db\data.sqlite
# Linux/Mac: ~/.local/share/provider/db.sqlite
# PROVIDER_DB_PATH=

# Blackbox.ai base URL
BLACKBOX_URL=https://app.blackbox.ai

# Email domain for OTP (catchmail.io)
TEMPMAIL_DOMAIN=catchmail.io

# Max concurrent browser instances
MAX_WORKERS=3

# Headless mode (true/false)
HEADLESS=true
